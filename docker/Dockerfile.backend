#Not used cuz we jus running frontend. Plus this shi WAAY too huge

FROM python:3.13-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

RUN TRANSFORMERS_OFFLINE=0 python -c "\
    from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('all-MiniLM-L6-v2', cache_folder='/install/hf_cache')"

FROM python:3.13-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
ENV HF_HOME=/usr/local/hf_cache
ENV TRANSFORMERS_OFFLINE=1
ENV SENTENCE_TRANSFORMERS_HOME=/usr/local/hf_cache

COPY backend/ ./backend/
COPY .env.example ./.env

RUN mkdir -p /app/data/uploads /app/data/vectorstore /app/data/jobs

RUN useradd -m -u 1000 ainsights && chown -R ainsights:ainsights /app
USER ainsights

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=8 --start-period=30s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--workers", "1", \
    "--timeout-keep-alive", "300", \
    "--log-level", "info"]