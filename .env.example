# Points at host machine — NOT localhost (localhost inside a container = the container itself)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Service-name URLs — how containers talk to each other on ainsights_net
BACKEND_URL=http://backend:8000

# Data paths inside the container filesystem (mounted from the app_data volume)
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
CHROMA_PERSIST_DIR=/app/data/vectorstore

# Embedding model (downloaded on first run from HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2
